#: _templates/api-reference.html
msgid "Documentazione tecnica delle funzioni e degli oggetti pubblici di MesPy, organizzata per modulo."
msgstr "Technical documentation for MesPy’s public functions and objects, organized by module."

#: _templates/api-reference.html
msgid "Ogni voce rimanda alla documentazione di firme, parametri e valori restituiti."
msgstr "Each entry links to documentation of signatures, parameters and return values."

#: _templates/api-reference.html
msgid "Caricamento dati"
msgstr "Data loading"

#: _templates/api-reference.html
msgid "Lettura di file CSV e validazione delle colonne e dei valori mancanti."
