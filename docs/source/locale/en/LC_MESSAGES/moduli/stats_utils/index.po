#: ../../source/moduli/stats_utils/index.md:25
msgid ""
"convertire dati in ingresso assimilabili ad array in vettori `float64` "
"monodimensionali"
msgstr "convert array-like inputs into one-dimensional `float64` vectors"

#: ../../source/moduli/stats_utils/index.md:26
msgid "intercettare dati in ingresso vuoti o non finiti"
msgstr "catch empty or non-finite inputs"

#: ../../source/moduli/stats_utils/index.md:27
msgid "gestire opzionalmente pesi strettamente positivi"
msgstr "optionally handle strictly positive weights"

#: ../../source/moduli/stats_utils/index.md:28
