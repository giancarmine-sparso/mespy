# mespy.mplstyle — stile predefinito di mespy (anteprima a schermo, notebook)
#
# Default di mespy.plot_utils.histogram(): barre blu con bordo bianco,
# griglia solo su y, palette seaborn "muted".
# Qui stanno solo le impostazioni con un equivalente diretto in rcParams;
# il resto (alpha delle barre, della banda, ...) è nei parametri di histogram().
# Uso: plt.style.use("mespy") dopo import mespy.

# --- Figure and layout ------------------------------------------------
figure.figsize: 8, 5
figure.dpi: 100
figure.facecolor: white
figure.constrained_layout.use: True

# --- Export -----------------------------------------------------------
savefig.dpi: 300
savefig.facecolor: white
pdf.fonttype: 42
ps.fonttype: 42
svg.fonttype: none

# --- Axes and number format -------------------------------------------
# Niente offset sull'asse (+1.234e3): i valori sui tick sono quelli veri.
axes.facecolor: white
axes.titlesize: 14
axes.titlepad: 10
axes.axisbelow: True
axes.formatter.useoffset: False
axes.formatter.use_mathtext: True

# --- Grid: solo y, dietro i dati --------------------------------------
axes.grid: True
axes.grid.axis: y
grid.alpha: 0.3
grid.linewidth: 0.5
grid.linestyle: -

# --- Legend -----------------------------------------------------------
legend.fontsize: 9
legend.loc: best
legend.framealpha: 0.9

# --- Patches ----------------------------------------------------------
# Il bordo bianco delle barre viene da force_edgecolor + patch.edgecolor.
# force_edgecolor vale per tutte le patch e collection senza edgecolor
# esplicito: anche axvspan e fill_between ricevono il bordo bianco.
# Il colore delle barre di hist() viene dal prop_cycle (C0), non da
# patch.facecolor; patch.facecolor = C0 serve per le patch create a mano.
patch.facecolor: 4878CF
patch.edgecolor: white
patch.force_edgecolor: True

# --- Color cycle ------------------------------------------------------
# Palette seaborn "muted" (BSD license). Non è la palette "colorblind":
# arancione (C1), verde (C2) e rosso (C3) sono poco distinguibili per
# deuteranopi e protanopi.
axes.prop_cycle: cycler('color', ['4878CF', 'EE854A', '6ACC64', 'D65F5F', '956CB4', '8C613C', 'DC7EC0', '797979', 'D5BB67', '82C6E2'])
